# ===== UNITY GENERATED FOLDERS (SAFE TO IGNORE) =====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/

# ===== UNITY GENERATED FILES =====
*.pidb
*.booproj
*.svd
*.user
*.userprefs
*.suo
*.tmp
*.pdb
*.opendb
*.VC.db

# ===== IDE & SYSTEM FILES =====
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# ===== VS & RIDER GENERATED FILES =====
*.csproj
*.sln

# ===== PACKAGE MANAGER CACHE =====
/Packages/com.unity.package-manager.cache/
Packages/packages-lock.json

# ===== KEEP THESE — YOUR ACTUAL PROJECT FILES =====
# Keep all scenes, scripts, assets, meta files, prefabs, shaders, hand rigs, timelines, etc.
!Assets/**
!Assets/**/*.meta
!Assets/**/*.unity
!Assets/**/*.cs
!Assets/**/*.prefab
!Assets/**/*.mat
!Assets/**/*.anim
!Assets/**/*.controller
!Assets/**/*.shader
!Assets/**/*.timeline
!Assets/**/*.playable
!Assets/**/*.asset
!Assets/**/*.json
!Assets/**/*.xml
!Assets/**/*.png
!Assets/**/*.jpg
!Assets/**/*.fbx
!Assets/**/*.wav
!Assets/**/*.mp3

# ===== INCLUDE METAS FOR SDKs & TRACKING =====
# If you’re using Meta SDK (e.g. Oculus Integration from Unity Asset Store), keep all files:
!Assets/Oculus/**
!Assets/Meta/**
!Assets/OVR/**
!Assets/Plugins/**
!Assets/XR/**
!Assets/HandTracking/**
!Assets/**/*Hand*.*
!Assets/**/*.meta

# ===== KEEP UNITY PROJECT SETTINGS =====
!ProjectSettings/ProjectVersion.txt
!ProjectSettings/EditorBuildSettings.asset
!ProjectSettings/TagManager.asset
!ProjectSettings/InputManager.asset
!ProjectSettings/GraphicsSettings.asset
!ProjectSettings/ProjectSettings.asset
!ProjectSettings/XRSettings.asset
!ProjectSettings/AudioManager.asset
!ProjectSettings/DynamicsManager.asset
!ProjectSettings/TimeManager.asset
!ProjectSettings/Physics2DSettings.asset
!ProjectSettings/PhysicsManager.asset
!ProjectSettings/NavMeshAreas.asset

# ===== KEEP TIMELINE DATA =====
!Assets/**/*.timeline
!Assets/**/*.playable
!Assets/Timeline/**

# ===== OPTIONAL: EXCLUDE CRASH REPORTING OR LARGE LOGS =====
*.stacktrace
*.crash

# ===== OPTIONAL: GIT LFS IF USED (e.g. large models/audio) =====
# .gitattributes should include:
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
